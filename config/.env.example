# Copy this file to config/.env and fill in the values.
# config/.env holds secrets and must never be committed.

# Telegram bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Target chat (required): "@channelname" or a numeric ID such as -1001234567890.
# The bot must be an admin of the channel to post in it.
TELEGRAM_CHAT_ID=@your_channel

# Optional proxy for Telegram API calls, e.g. socks5://127.0.0.1:1080.
# Required on an Iranian server/IP, where Telegram is filtered. Leave empty for a direct connection.
TELEGRAM_PROXY_URL=

# Path of the SQLite database file, relative to the project root.
DB_PATH=data/jobs.db

# Run the browser headless (true/false). The --headful CLI flag overrides this.
HEADLESS=true

# ── Phase 2: resume tailoring and the review bot ──────────────────────────

# Google Gemini API key. Needed only for resume tailoring; leave empty to disable it.
GEMINI_API_KEY=

# Optional proxy for LLM API calls, e.g. socks5://127.0.0.1:1080.
# The Gemini API is not available from Iranian IPs. Leave empty for a direct connection.
LLM_PROXY_URL=

# Comma-separated numeric Telegram user IDs allowed to use the bot, e.g. 123456789,987654321.
# Send /start to the bot in a private chat to get your ID. Empty disables the review flow.
TELEGRAM_ALLOWED_USER_IDS=

# Private chat that receives resumes and review packages: a positive numeric user ID.
# Leave empty to use the first ID in TELEGRAM_ALLOWED_USER_IDS. It must not be TELEGRAM_CHAT_ID.
TELEGRAM_REVIEW_CHAT_ID=
