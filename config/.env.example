# Copy this file to config/.env and fill in the values.
# config/.env holds secrets and must never be committed.

# Telegram bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Target chat (required): "@channelname" or a numeric ID such as -1001234567890.
# The bot must be an admin of the channel to post in it.
TELEGRAM_CHAT_ID=@your_channel

# Optional proxy for Telegram API calls, e.g. socks5://127.0.0.1:1080.
# Required on an Iranian server/IP, where Telegram is filtered. Leave empty for a direct connection.
TELEGRAM_PROXY_URL=

# Path of the SQLite database file, relative to the project root.
DB_PATH=data/jobs.db

# Run the browser headless (true/false). The --headful CLI flag overrides this.
HEADLESS=true
